{
  "name": "spatial-sync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint resources/js/ --fix && prettier --write 'resources/**/*.{js,css}'",
    "lint:check": "eslint resources/js/ --max-warnings=0 && prettier --check 'resources/**/*.{js,css}'",
    "prepare": "husky",
    "php:lint": "vendor/bin/pint --test",
    "php:stan": "vendor/bin/phpstan analyse --memory-limit=512M",
    "php:fix": "vendor/bin/pint",
    "commit": "cz",
    "validate": "npm run lint:check && npm run php:lint && npm run build",
    "version": "node -e \"console.log(require('./package.json').version)\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.26.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^1.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.32",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/three": "^0.185.1",
    "alpinejs": "^3.x",
    "axios": "^1.6.4",
    "fabric": "^5.3.0",
    "three": "^0.185.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
